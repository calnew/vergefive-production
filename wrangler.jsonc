{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vergefive-next-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vergefive-members",
      "database_id": "c9291712-1726-4010-8ff2-f64652c01d59"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vergefive-next-dev"
    }
  ]
}
