generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Entitlement {
  free
  self_serve
  done_with_you
  legacy_imported
  comped
  expired
}

enum BillingStatus {
  none
  active_subscription
  trialing
  past_due
  canceled
  unpaid
  one_time_paid
  legacy_imported
  manual_override
  refunded
}

enum IssueSeverity {
  high
  med
  low
}

enum IssueStatus {
  todo
  progress
  done
}

enum AccountCategory {
  vendor_net30
  secured_card
  credit_card
  funding
}

enum AccountTier {
  ready
  unlock_next
}

enum PurchaseStatus {
  pending
  paid
  failed
  refunded
  canceled
  disputed
}

enum SubscriptionStatus {
  incomplete
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

enum SupportStatus {
  new
  open
  pending
  resolved
  closed
}

enum SupportPriority {
  low
  normal
  high
  urgent
}

enum EmailTemplateStatus {
  draft
  active
  archived
}

enum EmailCampaignStatus {
  draft
  active
  paused
  completed
  archived
}

enum EmailLeadStatus {
  imported
  sent
  clicked
  registered
  do_not_contact
  bounced
}

enum EmailSendStatus {
  pending
  sent
  failed
  delivered
  opened
  clicked
  bounced
}

enum AdminRole {
  owner
  admin
  support
  viewer
}

enum AffiliateStatus {
  pending
  active
  paused
  disabled
}

enum CommissionStatus {
  pending
  payable
  paid
  canceled
}

enum ImportStatus {
  pending
  processing
  completed
  failed
  skipped
}

enum ReadinessLockStatus {
  clear
  settling
  review
  locked
}

model User {
  id                   String        @id @default(cuid())
  email                String        @unique
  passwordHash         String
  name                 String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  lastLoginAt          DateTime?
  emailVerifiedAt      DateTime?
  authProvider         String?
  entitlement          Entitlement   @default(free)
  billingStatus        BillingStatus @default(none)
  stripeCustomerId     String?
  stripeSubscriptionId String?

  businesses           Business[]
  membership           Membership?
  purchases            Purchase[]
  subscriptions        Subscription[]
  supportTickets       SupportTicket[]
  emailSends           EmailSend[]
  adminUser            AdminUser?
  adminNotes           AdminNote[]
  adminActivities      AdminActivityLog[] @relation("AdminActivityTargetUser")
  performedActivities  AdminActivityLog[] @relation("AdminActivityAdminUser")
  visibilityAudits     VisibilityAudit[]
  emailLeads           EmailLead[]
  affiliateReferrals   AffiliateReferral[]
  affiliateCommissions AffiliateCommission[]
  accessEvents         MemberAccessEvent[]
  readinessLock        MemberReadinessLock?
  reportSnapshots      ReportSnapshot[]
  passwordResetTokens  PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  importedUsers        ImportedUser[]

  @@index([entitlement])
  @@index([billingStatus])
  @@index([stripeCustomerId])
}

model Business {
  id             String   @id @default(cuid())
  userId         String
  name           String
  legalName      String?
  tradeName      String?
  entityType     String
  formationState String?
  ein            String?
  industry       String?
  address        String
  phone          String
  website        String
  email          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans           Scan[]
  visibilityAudits VisibilityAudit[]
  supportTickets  SupportTicket[]

  @@index([userId])
}

model Membership {
  id                   String        @id @default(cuid())
  userId               String        @unique
  entitlement          Entitlement   @default(free)
  billingStatus        BillingStatus @default(none)
  plan                 String?
  status               String        @default("pending")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  canceledAt           DateTime?
  cancelAtPeriodEnd    Boolean       @default(false)
  legacySource         String?
  manualReason         String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entitlement])
  @@index([billingStatus])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model Purchase {
  id                      String         @id @default(cuid())
  userId                  String?
  stripeCustomerId        String?
  stripeCheckoutSessionId String?        @unique
  stripePaymentIntentId   String?
  stripePriceId           String?
  product                 String
  plan                    String?
  amountCents             Int
  currency                String         @default("usd")
  status                  PurchaseStatus @default(pending)
  billingStatus           BillingStatus  @default(none)
  idempotencyKey          String?
  metadata                Json?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([status])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String?
  stripeCustomerId     String?
  stripeSubscriptionId String             @unique
  stripePriceId        String?
  product              String?
  plan                 String?
  status               SubscriptionStatus @default(incomplete)
  billingStatus        BillingStatus      @default(none)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  metadata             Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([status])
}

model StripeEvent {
  id           String   @id
  type         String
  processedAt  DateTime?
  payload      Json?
  processingError String?
  createdAt    DateTime @default(now())

  @@index([type])
  @@index([processedAt])
}

model Scan {
  id                  String         @id @default(cuid())
  businessId          String
  createdAt           DateTime       @default(now())
  generatedAt         DateTime       @default(now())
  readinessScore      Int
  grade               String
  signalsTotal        Int
  signalsClean        Int
  sourceMode          String?
  engine              String?
  findings            Json?
  redFlags            Json?
  evidence            Json?
  signals             Json?
  platformRecommendation String?
  disclaimer          String?

  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  issues         Issue[]
  accountMatches AccountMatch[]
  reportSnapshots ReportSnapshot[]

  @@index([businessId])
  @@index([createdAt])
}

model VisibilityAudit {
  id              String   @id @default(cuid())
  userId          String
  businessId      String?
  mode            String   @default("before")
  businessName    String?
  score           Int?
  label           String?
  sourceMode      String?
  engine          String?
  findings        Json?
  redFlags        Json?
  evidence        Json?
  signals         Json?
  platformRecommendation String?
  resultJson      Json
  generatedAt     DateTime?
  createdAt       DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([userId, mode, createdAt])
  @@index([businessId])
}

model Issue {
  id              String        @id @default(cuid())
  scanId          String
  key             String
  title           String
  detail          String
  severity        IssueSeverity
  impactRank      Int
  status          IssueStatus   @default(todo)
  potentialPoints Int?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([key])
  @@index([status])
}

model AccountMatch {
  id              String          @id @default(cuid())
  scanId          String
  catalogAccountId String?
  name            String
  category        AccountCategory
  tier            AccountTier
  reason          String
  unlockReason    String?
  faceBg          String
  cardTypeLabel   String?
  prereqLabels    Json?
  recommendedLine String?
  reportsNote     String?
  matchNote       String?
  helpfulNext     String?
  researchNote    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  scan           Scan            @relation(fields: [scanId], references: [id], onDelete: Cascade)
  catalogAccount CatalogAccount? @relation(fields: [catalogAccountId], references: [id], onDelete: SetNull)

  @@index([scanId])
  @@index([category])
  @@index([tier])
  @@index([catalogAccountId])
}

model CatalogAccount {
  id              String          @id @default(cuid())
  name            String
  category        AccountCategory
  tier            AccountTier     @default(unlock_next)
  description     String?
  reason          String?
  unlockReason    String?
  faceBg          String?
  logoUrl         String?
  outboundUrl     String?
  recommendedSignals Json?
  prerequisites   Json?
  reportsNote     String?
  active          Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  accountMatches AccountMatch[]

  @@index([category])
  @@index([tier])
  @@index([active, sortOrder])
}

model SupportTicket {
  id         String          @id @default(cuid())
  userId     String?
  businessId String?
  type       String?
  category   String?
  severity   String?
  priority   SupportPriority @default(normal)
  name       String?
  email      String?
  pageUrl    String?
  subject    String?
  message    String
  steps      String?
  browser    String?
  source     String?
  status     SupportStatus   @default(new)
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model EmailTemplate {
  id          String              @id @default(cuid())
  name        String
  category    String
  subject     String
  previewText String?
  bodyText    String
  bodyHtml    String?
  mergeFields Json?
  status      EmailTemplateStatus @default(draft)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  campaigns EmailCampaign[]
  sends     EmailSend[]

  @@index([category])
  @@index([status])
}

model EmailCampaign {
  id          String              @id @default(cuid())
  templateId  String?
  name        String
  subject     String
  previewText String?
  message     String
  status      EmailCampaignStatus @default(draft)
  source      String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  template EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  leads    EmailLead[]
  sends    EmailSend[]

  @@index([status])
  @@index([createdAt])
}

model EmailLead {
  id                    String          @id @default(cuid())
  campaignId            String
  importedUserId         String?
  userId                 String?
  firstName              String?
  lastName               String?
  email                  String
  phone                  String?
  businessName           String?
  source                 String?
  status                 EmailLeadStatus @default(imported)
  token                  String          @unique
  emailSentAt            DateTime?
  emailSendCount         Int             @default(0)
  clickedAt              DateTime?
  clickCount             Int             @default(0)
  registeredAt           DateTime?
  doNotContact           Boolean         @default(false)
  providerMessageId      String?
  providerResult         String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  campaign     EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  importedUser ImportedUser? @relation(fields: [importedUserId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  sends        EmailSend[]

  @@index([campaignId, createdAt])
  @@index([email])
  @@index([status])
}

model EmailSend {
  id                String          @id @default(cuid())
  userId            String?
  templateId         String?
  campaignId         String?
  leadId             String?
  toEmail            String
  fromEmail          String?
  replyTo            String?
  subject            String
  bodyTextSnapshot   String?
  bodyHtmlSnapshot   String?
  provider           String?
  providerMessageId  String?
  status             EmailSendStatus @default(pending)
  sentByAdminUserId  String?
  sentBySystem       Boolean         @default(false)
  sentAt             DateTime?
  deliveredAt        DateTime?
  openedAt           DateTime?
  clickedAt          DateTime?
  failedReason       String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  campaign   EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lead       EmailLead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sentByAdmin AdminUser?    @relation(fields: [sentByAdminUserId], references: [id], onDelete: SetNull)
  events     EmailEvent[]

  @@index([userId])
  @@index([templateId])
  @@index([campaignId])
  @@index([status])
  @@index([providerMessageId])
}

model EmailEvent {
  id               String   @id @default(cuid())
  emailSendId      String
  providerEventId  String?
  eventType        String
  payload          Json?
  occurredAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  emailSend EmailSend @relation(fields: [emailSendId], references: [id], onDelete: Cascade)

  @@index([emailSendId])
  @@index([eventType])
  @@index([providerEventId])
}

model AdminUser {
  id        String    @id @default(cuid())
  userId    String?   @unique
  email     String    @unique
  role      AdminRole @default(admin)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  notes      AdminNote[]
  activities AdminActivityLog[]
  emailSends EmailSend[]

  @@index([role])
  @@index([active])
}

model AdminNote {
  id          String   @id @default(cuid())
  userId      String
  adminUserId String?
  adminEmail  String?
  note        String
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([adminUserId])
}

model AdminActivityLog {
  id               String   @id @default(cuid())
  adminUserId      String?
  adminActorUserId String?
  adminEmail       String?
  userId           String?
  action           String
  details          Json?
  ipAddress        String?
  createdAt        DateTime @default(now())

  adminUser  AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  user       User?      @relation("AdminActivityTargetUser", fields: [userId], references: [id], onDelete: SetNull)
  adminActor User?      @relation("AdminActivityAdminUser", fields: [adminActorUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([adminUserId])
  @@index([adminActorUserId])
  @@index([adminEmail, createdAt])
  @@index([action])
}

model Affiliate {
  id                         String          @id @default(cuid())
  code                       String          @unique
  name                       String
  email                      String?
  status                     AffiliateStatus @default(active)
  commissionAmountCents       Int             @default(6000)
  monthlyQualifyingPayments   Int             @default(3)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  referrals   AffiliateReferral[]
  commissions AffiliateCommission[]

  @@index([status])
}

model AffiliateReferral {
  id           String   @id @default(cuid())
  affiliateId  String
  userId       String   @unique
  referralCode String
  landingPath  String?
  signupPath   String?
  createdAt    DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  commissions AffiliateCommission[]

  @@index([affiliateId])
  @@index([referralCode])
}

model AffiliateCommission {
  id                           String           @id @default(cuid())
  affiliateId                   String
  referralId                    String
  userId                        String
  plan                          String
  amountCents                   Int              @default(6000)
  currency                      String           @default("usd")
  status                        CommissionStatus @default(pending)
  qualifyingPaymentsRequired    Int              @default(1)
  qualifyingPaymentsCount       Int              @default(0)
  stripeCustomerId              String?
  stripeSubscriptionId          String?
  stripeCheckoutSessionId       String?
  eligibleAt                    DateTime?
  paidAt                        DateTime?
  notes                         String?
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt

  affiliate Affiliate          @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referral  AffiliateReferral  @relation(fields: [referralId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceEvents AffiliateInvoiceEvent[]

  @@unique([referralId, plan])
  @@index([affiliateId, status])
  @@index([stripeSubscriptionId])
}

model AffiliateInvoiceEvent {
  stripeInvoiceId String   @id
  commissionId    String
  createdAt       DateTime @default(now())

  commission AffiliateCommission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@index([commissionId])
}

model MemberAccessEvent {
  id        String   @id @default(cuid())
  userId    String
  pagePath  String
  eventType String   @default("page_view")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([pagePath])
}

model MemberReadinessLock {
  userId            String              @id
  status            ReadinessLockStatus @default(clear)
  reason            String?
  message           String?
  flaggedAt         DateTime?
  unlockAfter       DateTime?
  adminUnlockedAt   DateTime?
  adminUnlockedBy   String?
  updatedAt         DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, unlockAfter])
}

model ReportSnapshot {
  id             String   @id @default(cuid())
  userId         String
  scanId         String?
  reportType     String
  readinessStage String?
  summaryJson    Json
  downloadedAt   DateTime?
  createdAt      DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  scan Scan? @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([scanId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  email      String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  email      String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model ImportBatch {
  id           String       @id @default(cuid())
  sourceSystem String
  filename     String?
  status       ImportStatus @default(pending)
  totalRows    Int          @default(0)
  importedRows Int          @default(0)
  skippedRows  Int          @default(0)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  importedUsers ImportedUser[]

  @@index([sourceSystem])
  @@index([status])
}

model ImportedUser {
  id                       String       @id @default(cuid())
  importBatchId            String?
  linkedUserId             String?
  sourceSystem             String
  sourceId                 String?
  originalEmail            String
  normalizedEmail          String
  firstName                String?
  lastName                 String?
  businessName             String?
  phone                    String?
  importedMembershipStatus String?
  entitlement              Entitlement?
  billingStatus            BillingStatus?
  inviteStatus             String?
  inviteSentAt             DateTime?
  activatedAt              DateTime?
  rawData                  Json?
  status                   ImportStatus @default(pending)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  linkedUser  User?        @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)
  emailLeads  EmailLead[]

  @@index([importBatchId])
  @@index([linkedUserId])
  @@index([normalizedEmail])
  @@index([sourceSystem, sourceId])
}

model RateLimit {
  bucket    String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

